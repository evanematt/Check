    },
    {
      "when": {
        "state": "1",
        "facing": "east"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_b",
        "y": 90
      }
    },
    {
      "when": {
        "state": "1",
        "facing": "south"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_b",
        "y": 180
      }
    },
    {
      "when": {
        "state": "1",
        "facing": "west"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_b",
        "y": 270
      }
    }
  ]
