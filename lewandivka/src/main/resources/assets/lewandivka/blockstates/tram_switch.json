        "facing": "north"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_a",
        "y": 0
      }
    },
    {
      "when": {
        "state": "0",
        "facing": "east"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_a",
        "y": 90
      }
    },
    {
      "when": {
        "state": "0",
        "facing": "south"
      },
      "apply": {
        "model": "lewandivka:block/tram_switch_a",
        "y": 180
