{
  "multipart": [
    {
      "when": {
        "active": "false",
        "facing": "north"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay",
        "y": 0
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "east"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay",
        "y": 90
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "south"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay",
        "y": 180
      }
    },
    {
      "when": {
        "active": "false",
        "facing": "west"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay",
        "y": 270
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "north"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay_active",
        "y": 0
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "east"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay_active",
        "y": 90
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "south"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay_active",
        "y": 180
      }
    },
    {
      "when": {
        "active": "true",
        "facing": "west"
      },
      "apply": {
        "model": "lewandivka:block/chromatic_relay_active",
        "y": 270
      }
    }
  ]
}
